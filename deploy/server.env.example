# Generate a private server.env with deploy/init_env.py. Never reuse local .env.
COMPOSE_PROJECT_NAME=hr-intelligence
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
# Check host LAN/VPN routes and all Docker networks before selecting these ranges.
APP_NETWORK_SUBNET=172.16.240.0/24
DATA_NETWORK_SUBNET=172.16.241.0/24
ADAPTER_RUNNER_CONTROL_SUBNET=172.16.243.0/24
DISCOVERY_SEARCH_CONTROL_SUBNET=172.16.246.0/24
APP_URL=http://127.0.0.1:18080
COOKIE_SECURE=false
PUBLIC_DNS_RESOLVER=alidns
CHECKPOINT_MAX_AGE_SECONDS=3600
CHECKPOINT_MAX_RAW_BYTES=30000000
CHECKPOINT_MAX_STEPS=600
CHECKPOINT_MAX_RECORDS=500
POSTGRES_PASSWORD=GENERATE_A_NEW_SECRET
REDIS_PASSWORD=GENERATE_A_NEW_SECRET
APP_SECRET=GENERATE_A_NEW_SECRET
ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_A_NEW_PASSWORD_AT_LEAST_12_CHARACTERS
# Models are disabled by default; change only when intentional.
LLM_DAILY_REQUEST_LIMIT=0
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-5.3
LLM_FALLBACK_MODEL=deepseek-flash
# Optional BettaFish bridge: defaults inactive. These paths must exist inside containers.
BETTAFISH_REPO_DIR=
BETTAFISH_PYTHON=
BETTAFISH_REVISION=b67928ff1ce515dd7672408221fb1e9500d0972d
BETTAFISH_LICENSE_CONFIRMED=false
BETTAFISH_TIMEOUT_SECONDS=600
