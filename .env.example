APP_ENV=development
APP_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://hr_research:CHANGE_ME@127.0.0.1:55432/hr_research
TEST_DATABASE_URL=postgresql+psycopg://hr_research:CHANGE_ME@127.0.0.1:55432/hr_research_test
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:56379/0
APP_SECRET=
ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=false
PUBLIC_DNS_FALLBACK=false
# Used only when the local DNS returns TUN fake IPs; public IP validation stays enabled.
PUBLIC_DNS_RESOLVER=alidns
CHECKPOINT_MAX_AGE_SECONDS=3600
CHECKPOINT_MAX_RAW_BYTES=30000000
CHECKPOINT_MAX_STEPS=600
CHECKPOINT_MAX_RECORDS=500
# Optional isolated adapter runner. Leave empty until its control network is configured.
ADAPTER_RUNNER_URL=
ADAPTER_RUNNER_TOKEN=
ADAPTER_RUNNER_RUNTIME_DIGEST=
ADAPTER_RUNNER_TIMEOUT_SECONDS=90
# Docker overlay only; create the dedicated network before using compose.code-maintenance.yaml.
ADAPTER_RUNNER_CONTROL_NETWORK=
# Optional deployment-owned search endpoint; only this exact internal API gets private-network access.
DISCOVERY_INTERNAL_SEARCH_URL=
DISCOVERY_SEARCH_TIMEOUT_SECONDS=15
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=
LLM_FALLBACK_MODEL=
LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
LLM_DAILY_REQUEST_LIMIT=12
LLM_TASK_CALL_LIMIT=3
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=16000
LLM_TIMEOUT_SECONDS=90
BETTAFISH_URL=
BETTAFISH_REPO_DIR=
BETTAFISH_PYTHON=
BETTAFISH_REVISION=b67928ff1ce515dd7672408221fb1e9500d0972d
BETTAFISH_LICENSE_CONFIRMED=false
BETTAFISH_TIMEOUT_SECONDS=600
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Only list explicitly authorized internal webhook hostnames, never a wildcard.
NOTIFICATION_ALLOWED_HOSTS=
